DB_HOST=localhost
DB_PORT=5432
DB_USER=bluer_book
DB_PASS=xxx
DB_NAME=bluer_book

# The role the server connects as. It owns no table and bypasses no policy, so
# home isolation actually applies to it. `migrate` creates it and sets this
# password; `server` refuses to start without APP_DB_USER.
APP_DB_USER=bluer_book_app
APP_DB_PASS=xxx
